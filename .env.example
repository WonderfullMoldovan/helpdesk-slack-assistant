# ============================================================
# IT Helpdesk Slack Assistant — Environment Variables Template
# ============================================================
#
# Usage: cp .env.example .env, then fill in real values.
# NEVER commit .env with real secrets.
#
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_ENV=development
LOG_LEVEL=DEBUG

# ----------------------------
# Database (PostgreSQL)
# ----------------------------
# Format: postgresql+asyncpg://user:password@host:port/database
POSTGRES_DSN=postgresql+asyncpg://helpdesk:helpdesk_dev_password@postgres:5432/helpdesk

# Individual components (used by docker-compose for the postgres container)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password
POSTGRES_DB=helpdesk

# ----------------------------
# Redis
# ----------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------
# Azure OpenAI
# ----------------------------
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY_CHAT=your-chat-key
AZURE_OPENAI_API_KEY_EMBEDDING=your-embedding-key

# API versions
AZURE_OPENAI_API_VERSION_CHAT=2025-04-01-preview
AZURE_OPENAI_API_VERSION_EMBEDDING=2023-05-15

# Deployment names (Azure-specific, not OpenAI model names)
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5.4
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# Operational tunables
# Embedding dimensions — must match the Vector(N) column in DB
# text-embedding-3-large native is 3072; we truncate to 1536 via dimensions param
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# Reasoning effort for gpt-5.4 series: low / medium / high
AZURE_OPENAI_REASONING_EFFORT=medium
# ----------------------------
# Slack
# ----------------------------
# Bot token (from Slack App → OAuth & Permissions → Bot User OAuth Token)
# Starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret (from Slack App → Basic Information → App Credentials)
# Used to verify webhook authenticity (HMAC-SHA256)
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-level token (from Slack App → Basic Information → App-Level Tokens)
# Starts with xapp-, used for Socket Mode (alternative to webhooks)
# Optional in v1 if using webhook mode with ngrok
SLACK_APP_TOKEN=xapp-your-app-token-here

# ----------------------------
# Langfuse (observability)
# ----------------------------
# Public and secret keys from your Langfuse project settings
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Langfuse Cloud (EU region) — default
LANGFUSE_HOST=https://cloud.langfuse.com
# For US region:
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# For self-hosted:
# LANGFUSE_HOST=http://langfuse:3000

# ----------------------------
# Agent behavior
# ----------------------------
# Confidence threshold below which Supervisor escalates to human
SUPERVISOR_CONFIDENCE_THRESHOLD=0.7

# Max number of graph transitions per user message (infinite loop protection)
MAX_GRAPH_STEPS=15

# Reminder configuration (per Charter / ADR)
REMINDER_INTERVAL_HOURS=4
MAX_REMINDERS_PER_ESCALATION=2